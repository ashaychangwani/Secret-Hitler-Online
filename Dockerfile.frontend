FROM node:18-bullseye-slim AS build
WORKDIR /src
COPY frontend/package*.json ./
RUN npm ci --legacy-peer-deps
COPY frontend/ .
ARG REACT_APP_SERVER_ADDRESS=secret-hitler.ashayc.com
ARG REACT_APP_SERVER_ADDRESS_HTTP=https://secret-hitler.ashayc.com
ARG REACT_APP_WEBSOCKET_HEADER=wss://
ENV REACT_APP_SERVER_ADDRESS=$REACT_APP_SERVER_ADDRESS REACT_APP_SERVER_ADDRESS_HTTP=$REACT_APP_SERVER_ADDRESS_HTTP REACT_APP_WEBSOCKET_HEADER=$REACT_APP_WEBSOCKET_HEADER
RUN CI=false npm run build
FROM nginx:1.27-alpine
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/build/ /usr/share/nginx/html/
COPY LICENSE /usr/share/nginx/html/LICENSE
EXPOSE 80
